<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\application\RemTool.Application.csproj" />
    <ProjectReference Include="..\shared\RemTool.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.25">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="EPPlus" Version="8.5.1" />
  </ItemGroup>
  <Target Name="BuildAdminUi" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm install --ignore-scripts" WorkingDirectory="$(MSBuildProjectDirectory)\..\admin-ui" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\admin-ui" />
    <ItemGroup>
      <AdminUiBuildOutput Include="$(MSBuildProjectDirectory)\..\admin-ui\out\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminUiBuildOutput)"
          DestinationFiles="@(AdminUiBuildOutput -> '$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
